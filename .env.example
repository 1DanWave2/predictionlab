# PredictionLab configuration. Every variable below is read by app/config.py;
# values shown are the code defaults. Copy to .env and edit.

# --- Application ---
APP_NAME=Polymarket Paper Bot
APP_ENV=dev
APP_MODE=paper_auto
LOG_LEVEL=INFO
ENABLE_LIVE_TRADING=false
USE_MOCK_DATA=true
DATABASE_URL=sqlite:///./paper_bot.db
API_HOST=127.0.0.1
API_PORT=8000

# --- Polymarket endpoints ---
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
WEBSOCKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/

# --- Loop intervals (seconds) ---
SCAN_INTERVAL_SECONDS=5.0
TRADE_INTERVAL_SECONDS=5.0
REPORT_INTERVAL_SECONDS=3600.0

# --- Risk limits ---
MAX_OPEN_POSITIONS=5
MAX_POSITION_SIZE=200.0
MAX_ORDER_NOTIONAL=10.0
MIN_ORDER_NOTIONAL=2.0
HIGH_CONF_NOTIONAL=10.0
HIGH_CONF_THRESHOLD=0.7
DAILY_LOSS_LIMIT=10.0
MARKET_COOLDOWN_SECONDS=120
STOPLOSS_COOLDOWN_SECONDS=7200
MAX_TRADES_PER_MARKET=1
DEFAULT_ORDER_SIZE=4.0
INITIAL_PAPER_BALANCE=100.0

# --- Exit rules ---
TAKE_PROFIT_PCT=0.3
STOP_LOSS_PCT=0.03
MIN_SL_AGE_MINUTES=15.0
STALE_EXIT_HOURS=48.0
HARD_STOP_MIN_AGE_MINUTES=3.0
HARD_STOP_MAX_SPREAD=0.15

# --- Outbound webhooks (n8n or any HTTP endpoint) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Telegram (used by the n8n workflow) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM veto (OpenAI-compatible endpoint) ---
AI_VETO_ENABLED=false
GROQ_API_KEY=
AI_VETO_MODEL=llama-3.3-70b-versatile
AI_VETO_BASE_URL=https://api.groq.com/openai/v1
AI_VETO_CACHE_MINUTES=10.0
AI_VETO_TIMEOUT_S=15.0

# --- LLM fair price ---
AI_FAIR_PRICE_ENABLED=false
AI_FAIR_PRICE_MODEL=llama-3.3-70b-versatile
AI_FAIR_PRICE_CACHE_MINUTES=30.0
AI_FAIR_PRICE_TIMEOUT_S=20.0
AI_FAIR_PRICE_MIN_CONFIDENCE=0.6
AI_FAIR_PRICE_MIN_EDGE=0.1

# --- Consensus drift / classifier ---
CONSENSUS_DRIFT_ENABLED=false
CONSENSUS_DRIFT_ONLY=false
CLASSIFIER_CACHE_MINUTES=60.0

# --- Sports sniper + The Odds API ---
SNIPER_ENABLED=false
SNIPER_LIVE_ENABLED=false
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_CACHE_SECONDS=300.0
ODDS_API_REGIONS=us,uk
SNIPER_LIVE_MAX_SIZE_USD=5.0
SNIPER_LIVE_MAX_OPEN=1
SNIPER_LIVE_DAILY_STOP_USD=4.0
SNIPER_LIVE_WEEKLY_STOP_USD=8.0
SNIPER_SPORT_KEYS=

# --- Other ---
ASSET_TARGET_ENABLED=false
ASSET_TARGET_LIVE_ENABLED=false
ASSET_TARGET_LIVE_SIZE_USD=5.0
ASSET_TARGET_LIVE_MAX_OPEN=2
ASSET_TARGET_MAX_PER_ASSET=2
FINANCIAL_STRATEGY_ENABLED=true
FINANCIAL_STRATEGY_MAX_SIZE_USD=7.5
FINANCIAL_STRATEGY_DAILY_STOP=4.0
# --- Strategy toggles read directly from the environment (not in Settings) ---
FADE_ANY_ENABLED=false
MOMENTUM_ENABLED=true
POST_PANIC_REBOUND_ENABLED=false
CONSENSUS_DRIFT_LITE=false
REVERSE_MODE=false
STRATEGY_DEBUG=false
FUNNEL_LOG_PATH=./data/funnel.jsonl
WEBHOOK_SECRET_TOKEN=
